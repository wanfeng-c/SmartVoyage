# SmartVoyage 环境变量示例
# 复制为 .env 后填入自己的真实值：  Copy-Item .env.example .env
# 所有占位符都要替换，真实值不要提交到 Git（.env 已在 .gitignore 中）

# ===== DeepSeek（Agent 模型，必填）=====
# 形如 sk-xxxxxxxx，在 https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 可选，不填则使用下面的默认值
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# ===== MySQL（机票 / 火车票 / 演唱会 / 租车 / 保险 查询，必填）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=travel_rag

# ===== 阿里云百炼 DashScope（旅游团 embedding，必填）=====
# 与 DeepSeek 的 Key 不是同一个，在 https://bailian.console.aliyun.com 创建
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ===== Milvus（旅游团向量检索，可选）=====
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_COLLECTION=tour_groups

# ===== Web 服务（可选）=====
# WEB_PORT=8100

# ===== 和风天气 QWeather（天气查询，必填）=====
# 在 https://dev.qweather.com 创建项目后获得，Host 形如 xxxx.re.qweatherapi.com
QWEATHER_HOST=your-qweather-api-host
QWEATHER_KEY=your-qweather-api-key
